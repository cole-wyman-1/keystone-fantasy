---
import Layout from '../components/Layout.astro';
import TeamCell from '../components/TeamCell.astro';
import { meta, leagues, standings, highs, weekly, people, power, u, leagueUrl, personUrl, fmt, record } from '../lib/data';
const lastWeek = highs.weeks.length ? highs.weeks[highs.weeks.length - 1] : null;
const leaderboard = highs.leaderboard.slice(0, 8);
const topPower = power.slice(0, 10);
const inProgressWeek = Object.values(weekly).flatMap((w: any) => Object.values(w)).find((w: any) => !w.complete) as any;
---
<Layout>
  <h1>Keystone Fantasy Football 2026</h1>
  <p class="muted">{meta.n_leagues} leagues · {meta.n_people} managers · {meta.weeks_complete} week{meta.weeks_complete === 1 ? '' : 's'} complete{inProgressWeek ? ` · week ${inProgressWeek.week} in progress` : ''}</p>

  {lastWeek && (
    <div class="stat-row">
      <div class="stat"><div class="lbl">Top score, week {lastWeek.week}</div><div class="val">{fmt(lastWeek.overall.points)}</div>
        <div class="sub"><a href={personUrl(lastWeek.overall.slot_id)}><strong>{lastWeek.overall.team_name}</strong></a> · {lastWeek.overall.owner} · {lastWeek.overall.league_code}</div></div>
      {topPower[0] && <div class="stat"><div class="lbl">Power #1</div><div class="val">{topPower[0].team_name}</div><div class="sub">{topPower[0].owner} · {topPower[0].league_code} · {fmt(topPower[0].ppg)} ppg</div></div>}
      {leaderboard[0] && <div class="stat"><div class="lbl">Most weekly highs</div><div class="val">{leaderboard[0].team_name}</div><div class="sub">{leaderboard[0].owner} · {leaderboard[0].count} week{leaderboard[0].count === 1 ? '' : 's'} · {leaderboard[0].league_code}</div></div>}
    </div>
  )}

  <h2>Leagues</h2>
  <div class="cards">
    {leagues.map((l) => {
      const rows = standings[l.code] ?? [];
      const lead = rows[0];
      const hi = lastWeek?.per_league[l.code];
      return (
        <a class="card" href={leagueUrl(l.code)} style="color:inherit">
          <h3>{l.name}</h3>
          <div class="small muted">{l.scoring_format} · {l.weeks_complete} wk complete</div>
          {lead && <div style="margin-top:8px"><span class="badge acc">1st</span> <strong>{lead.team_name}</strong> <span class="muted small">{lead.owner} · {record(lead)}, {fmt(lead.points_for)} PF</span></div>}
          {hi && <div><span class="badge gold">Wk {lastWeek.week} high</span> <strong>{hi.team_name}</strong> <span class="muted small">{hi.owner} · {fmt(hi.points)}</span></div>}
        </a>
      );
    })}
  </div>

  <h2>Cross-league power ranking</h2>
  {topPower.length === 0 ? <p class="muted">No completed weeks yet.</p> : (
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>#</th><th>Team</th><th>League</th><th class="num">Score</th><th class="num">PPG</th><th class="num hide-sm">W-L</th></tr></thead>
    <tbody>{topPower.map((r: any) => (<tr><td class="num">{r.power_rank}</td><td><TeamCell slotId={r.slot_id} teamName={r.team_name} owner={r.owner} /></td><td class="muted">{r.league_code}</td><td class="num"><strong>{fmt(r.power_score, 1)}</strong></td><td class="num">{fmt(r.ppg)}</td><td class="num hide-sm">{record(r)}</td></tr>))}</tbody></table></div>
  )}
  <p class="small muted">Top 10 of 84. Score = 60% points per game + 25% all-play win % + 15% last-3-week scoring. <a href={u('power/')}>Full ranking →</a></p>
  <p><a href={u('weekly-highs/')}>Weekly highs →</a> · <a href={u('records/')}>Record book →</a></p>
</Layout>
