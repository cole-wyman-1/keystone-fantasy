---
import Layout from '../components/Layout.astro';
import TeamCell from '../components/TeamCell.astro';
import { highs, leagues, personUrl, fmt } from '../lib/data';
const weeks = [...highs.weeks].reverse();
---
<Layout title="Weekly High Scores">
  <h1>Weekly high scores</h1>
  <p class="muted">The top scorer in each league every week, and the overall top score across all seven leagues.</p>

  <h2>Leaderboard: most weekly highs</h2>
  {highs.leaderboard.length === 0 ? <p class="muted">No completed weeks yet.</p> : (
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>#</th><th>Team</th><th>League</th><th class="num">Weeks</th></tr></thead>
    <tbody>{highs.leaderboard.map((r: any, i: number) => (<tr><td class="num">{i + 1}</td><td><TeamCell slotId={r.slot_id} teamName={r.team_name} owner={r.owner} /></td><td class="muted">{r.league_code}</td><td class="num">{r.count}</td></tr>))}</tbody></table></div>
  )}

  {weeks.map((w: any) => (<>
    <h2>Week {w.week} <span class="badge gold">Overall: {w.overall.team_name} ({w.overall.owner}) {fmt(w.overall.points)}</span></h2>
    <div class="tbl-wrap"><table class="tbl"><thead><tr><th>League</th><th>Top team</th><th class="num">Points</th></tr></thead>
      <tbody>{leagues.map((l) => { const h = w.per_league[l.code]; return h ? (<tr class={l.code === w.overall.league_code ? 'hi' : ''}><td>{l.name}</td><td><TeamCell slotId={h.slot_id} teamName={h.team_name} owner={h.owner} /></td><td class="num"><strong>{fmt(h.points)}</strong></td></tr>) : null; })}</tbody></table></div>
  </>))}
</Layout>
