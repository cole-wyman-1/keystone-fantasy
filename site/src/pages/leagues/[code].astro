---
import Layout from '../../components/Layout.astro';
import StandingsTable from '../../components/StandingsTable.astro';
import Matchups from '../../components/Matchups.astro';
import { leagues, standings, weekly, records, personUrl, fmt } from '../../lib/data';

export function getStaticPaths() {
  return leagues.map((l) => ({ params: { code: l.code.toLowerCase() }, props: { league: l } }));
}
const { league } = Astro.props;
const rows = standings[league.code] ?? [];
const weeks = Object.values(weekly[league.code] ?? {}).sort((a: any, b: any) => a.week - b.week) as any[];
const inProgress = weeks.find((w) => !w.complete);
const complete = weeks.filter((w) => w.complete);
const latest = complete[complete.length - 1];
const earlier = complete.slice(0, -1).reverse();
const rb = records.per_league[league.code];
const playoffLine = `${league.playoff_teams} teams make the playoffs after week ${league.regular_season_weeks}.`;
const cards = rb ? [['Highest score', rb.highest_score[0], 'points'], ['Lowest score', rb.lowest_score[0], 'points'], ['Biggest blowout', rb.biggest_blowout[0], 'margin'], ['Closest game', rb.closest_game[0], 'margin'], ['Most points in a loss', rb.most_points_in_loss[0], 'points'], ['Fewest points in a win', rb.fewest_points_in_win[0], 'points'], ['Most bench points', rb.most_bench_points[0], 'bench_points'], ['Best player week', rb.best_player_week[0], 'player_points']].filter(([, r]) => r) : [];
---
<Layout title={league.name}>
  <h1>{league.name}</h1>
  <p class="muted">ESPN: {league.espn_name} · {league.scoring_format} · {league.regular_season_weeks}-week regular season · {playoffLine}</p>

  <h2>Standings</h2>
  <StandingsTable rows={rows} />
  <p class="small muted">Luck = actual wins minus expected wins, where expected wins come from playing every other team every week (all-play).</p>

  {inProgress && (<>
    <h2>Week {inProgress.week} <span class="badge acc">in progress</span></h2>
    <Matchups matchups={inProgress.matchups} complete={false} />
  </>)}

  {latest && (<>
    <h2>Week {latest.week} results</h2>
    <p class="small"><span class="badge gold">High</span> <a href={personUrl(latest.high.slot_id)}>{latest.high.owner}</a> {fmt(latest.high.points)} · <span class="badge">Low</span> <a href={personUrl(latest.low.slot_id)}>{latest.low.owner}</a> {fmt(latest.low.points)}</p>
    <Matchups matchups={latest.matchups} />
  </>)}

  {complete.length > 0 && (<>
    <h2>Weekly high scorers</h2>
    <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Week</th><th>High</th><th class="num">Pts</th><th class="hide-sm">Low</th><th class="num hide-sm">Pts</th></tr></thead>
      <tbody>{complete.map((w) => (<tr><td>{w.week}</td><td><a href={personUrl(w.high.slot_id)}>{w.high.owner}</a></td><td class="num">{fmt(w.high.points)}</td><td class="hide-sm"><a href={personUrl(w.low.slot_id)}>{w.low.owner}</a></td><td class="num hide-sm">{fmt(w.low.points)}</td></tr>))}</tbody></table></div>
  </>)}

  {cards.length > 0 && (<>
    <h2>League records (season to date)</h2>
    <div class="cards">
      {cards.map(([label, r, key]: any) => (
        <div class="card"><div class="small muted">{label}</div><div style="font-weight:700;font-size:1.2rem">{fmt(r[key])}</div>
          <div><a href={personUrl(r.slot_id)}>{r.owner}</a> <span class="muted small">wk {r.week}{key === 'player_points' ? ` · ${r.player} (${r.position})` : ''}</span></div></div>
      ))}
    </div>
  </>)}

  {earlier.length > 0 && (<>
    <h2>Earlier weeks</h2>
    {earlier.map((w) => (<details><summary>Week {w.week} · High: {w.high.owner} {fmt(w.high.points)}</summary><Matchups matchups={w.matchups} /></details>))}
  </>)}
</Layout>
