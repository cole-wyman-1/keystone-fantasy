---
import TeamCell from './TeamCell.astro';
import { fmt } from '../lib/data';
const { title, rows, valueKey, valueLabel = 'Points', note = '', showLeague = true, extra = null } = Astro.props;
---
<h3>{title}</h3>
{note && <p class="small muted" style="margin-top:-4px">{note}</p>}
{rows.length === 0 ? <p class="muted small">Nothing yet.</p> : (
<div class="tbl-wrap">
  <table class="tbl">
    <thead><tr><th>#</th><th>Team</th>{showLeague && <th class="hide-sm">League</th>}<th class="num">Wk</th><th class="num">{valueLabel}</th><th class="hide-sm">Detail</th></tr></thead>
    <tbody>
      {rows.map((r: any, i: number) => (
        <tr>
          <td class="num">{i + 1}</td>
          <td><TeamCell slotId={r.slot_id} teamName={r.team_name} owner={r.owner} icons={false} /></td>
          {showLeague && <td class="muted hide-sm">{r.league_code}</td>}
          <td class="num">{r.week}</td>
          <td class="num"><strong>{typeof r[valueKey] === 'number' ? fmt(r[valueKey]) : r[valueKey]}</strong></td>
          <td class="muted small hide-sm">{extra ? extra(r) : `vs ${r.opp_team_name} (${fmt(r.opp_points)}), ${r.result === 'W' ? 'won' : r.result === 'L' ? 'lost' : 'tied'}`}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
)}
