---
import TeamCell from './TeamCell.astro';
import { fmt, record } from '../lib/data';
const { rows, highlight = null, showLeague = false, playoffTeams = 6 } = Astro.props;
// Byes = spots left over when the playoff field is padded up to the next power of two (6 teams -> 2 byes).
const bracket = playoffTeams > 0 ? 2 ** Math.ceil(Math.log2(playoffTeams)) : 0;
const byes = bracket - playoffTeams;
const lineClass = (rank: number) =>
  rank === byes && byes > 0 ? 'bye-line' : rank === playoffTeams && playoffTeams > 0 ? 'playoff-line' : '';
const mark = (p: string) => (p === 'clinched' ? 'x' : p === 'eliminated' ? 'e' : '');
const anyMarks = rows.some((r: any) => mark(r.playoff));
---
<div class="tbl-wrap">
  <table class="tbl">
    <thead>
      <tr>
        <th>#</th><th>Team</th>{showLeague && <th>League</th>}<th class="num">W-L</th><th class="num">PF</th>
        <th class="num hide-sm">PA</th><th class="num">PPG</th><th class="hide-sm">Streak</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r: any) => (
        <tr class={`${r.slot_id === highlight ? 'me' : ''} ${lineClass(r.rank)}`.trim()}>
          <td class="num">{r.rank}</td>
          <td><span class="cell-row"><TeamCell slotId={r.slot_id} teamName={r.team_name} owner={r.owner} />{mark(r.playoff) && <span class={`mark ${mark(r.playoff)}`} title={r.playoff === 'clinched' ? 'Clinched playoff spot' : 'Eliminated from playoffs'}>{mark(r.playoff)}</span>}</span></td>
          {showLeague && <td class="muted">{r.league_code}</td>}
          <td class="num">{record(r)}</td>
          <td class="num">{fmt(r.points_for)}</td>
          <td class="num hide-sm">{fmt(r.points_against)}</td>
          <td class="num">{fmt(r.ppg)}</td>
          <td class="hide-sm"><span class={`badge ${r.streak_type === 'W' ? 'win' : r.streak_type === 'L' ? 'loss' : ''}`}>{r.streak}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="small muted legend">
  {byes > 0 && <span><span class="line-key bye"></span> top {byes} earn a first-round bye</span>}
  {playoffTeams > 0 && <span><span class="line-key po"></span> top {playoffTeams} make the playoffs</span>}
  {anyMarks && <span><b class="mark x">x</b> clinched · <b class="mark e">e</b> eliminated</span>}
</p>
