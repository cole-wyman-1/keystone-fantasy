---
import { personUrl, fmt } from '../lib/data';
const { matchups, complete = true } = Astro.props;
---
<div class="matchups">
  {matchups.map((m: any) => {
    const hw = complete && m.home.points > m.away.points, aw = complete && m.away.points > m.home.points;
    return (
      <div class="mu">
        <div class={`team ${hw ? 'winner' : aw ? 'loser' : ''}`}><a href={personUrl(m.home.slot_id)}><strong>{m.home.team_name}</strong></a><span class="tn">{m.home.owner}</span></div>
        <div class={`pts ${hw ? 'winner' : aw ? 'loser' : ''}`}>{fmt(m.home.points)}</div>
        <div class={`team ${aw ? 'winner' : hw ? 'loser' : ''}`}><a href={personUrl(m.away.slot_id)}><strong>{m.away.team_name}</strong></a><span class="tn">{m.away.owner}</span></div>
        <div class={`pts ${aw ? 'winner' : hw ? 'loser' : ''}`}>{fmt(m.away.points)}</div>
        <div class="foot">{complete ? `Margin ${fmt(m.margin)}` : 'In progress'}{m.home.bench_points != null && complete ? ` · Bench ${fmt(m.home.bench_points, 1)} / ${fmt(m.away.bench_points, 1)}` : ''}</div>
      </div>
    );
  })}
</div>
