---
import { meta, leagues, u, leagueUrl, fmtDateET, isStale } from '../lib/data';
const { title, description = 'Keystone Fantasy Football 2026: standings, weekly high scores and the record book for all seven leagues.' } = Astro.props;
const stale = isStale(meta.last_successful_fetch_utc);
const path = Astro.url.pathname;
const nav = [
  { href: u('/'), label: 'Home' },
  { href: u('weekly-highs/'), label: 'Weekly Highs' },
  { href: u('records/'), label: 'Records' },
  { href: u('power/'), label: 'Power' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title ? `${title} · Keystone Fantasy` : 'Keystone Fantasy 2026'}</title>
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="6" fill="#1f5aa6"/><text x="16" y="22" font-size="16" text-anchor="middle" fill="#fff" font-family="system-ui" font-weight="700">K</text></svg>')}`} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={u('/')}>Keystone Fantasy <span>2026</span></a>
        <nav class="nav">
          {nav.map((n) => <a href={n.href} class={path === n.href ? 'active' : ''}>{n.label}</a>)}
        </nav>
      </div>
      <div class="wrap leagues-nav">
        {leagues.map((l) => <a href={leagueUrl(l.code)} class={path === leagueUrl(l.code) ? 'active' : ''}>{l.name.replace(' League', '')}</a>)}
      </div>
    </header>
    <main class="wrap">
      {stale && <div class="banner warn">Data may be stale: the last successful ESPN refresh was {fmtDateET(meta.last_successful_fetch_utc)}.</div>}
      <slot />
    </main>
    <footer class="wrap foot">
      <p>Last successful ESPN refresh: <strong>{fmtDateET(meta.last_successful_fetch_utc)}</strong> · Weeks complete: {meta.weeks_complete} · Records use completed weeks only.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --fg: #1a1d21; --muted: #5f6b7a; --line: #e3e7ec; --soft: #f5f7fa;
    --accent: #1f5aa6; --accent-soft: #e8f0fb; --win: #1f8a4c; --loss: #c53a3a; --gold: #b7791f; --gold-soft: #fff6e0;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1 { font-size: 1.6rem; margin: 0.2em 0 0.4em; letter-spacing: -0.01em; }
  h2 { font-size: 1.15rem; margin: 1.8em 0 0.6em; }
  h3 { font-size: 1rem; margin: 1.2em 0 0.4em; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .site-header .wrap:first-child { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 12px; padding-bottom: 8px; flex-wrap: wrap; }
  .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); }
  .brand span { color: var(--accent); }
  .nav { display: flex; gap: 14px; flex-wrap: wrap; }
  .nav a, .leagues-nav a { color: var(--muted); font-weight: 500; padding: 4px 0; border-bottom: 2px solid transparent; white-space: nowrap; }
  .nav a.active, .leagues-nav a.active { color: var(--accent); border-color: var(--accent); }
  .leagues-nav { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 8px; font-size: 0.9rem; scrollbar-width: none; }
  .leagues-nav::-webkit-scrollbar { display: none; }
  main { padding-top: 16px; padding-bottom: 40px; }
  .foot { color: var(--muted); font-size: 0.85rem; border-top: 1px solid var(--line); padding-top: 12px; padding-bottom: 32px; }
  .muted { color: var(--muted); }
  .small { font-size: 0.85rem; }
  .banner { padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; background: var(--soft); }
  .banner.warn { background: #fff4e5; color: #7a4b00; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .card { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; background: var(--bg); }
  .card h3 { margin: 0 0 6px; }
  .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin: 12px 0; }
  .stat { background: var(--soft); border-radius: 8px; padding: 10px 12px; }
  .stat .lbl { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .stat .val { font-size: 1.25rem; font-weight: 700; }
  .stat .sub { font-size: 0.8rem; color: var(--muted); }
  .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 8px 0 4px; }
  table.tbl { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .tbl th, .tbl td { padding: 7px 8px; border-bottom: 1px solid var(--line); text-align: left; white-space: nowrap; }
  .tbl th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 600; background: var(--soft); }
  .tbl td.num, .tbl th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .tbl tr.me td { background: var(--accent-soft); }
  .tbl tr.hi td { background: var(--gold-soft); }
  .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; padding: 1px 7px; border-radius: 999px; background: var(--soft); color: var(--muted); vertical-align: middle; }
  .badge.win { background: #e3f4ea; color: var(--win); }
  .badge.loss { background: #fbe4e4; color: var(--loss); }
  .badge.gold { background: var(--gold-soft); color: var(--gold); }
  .badge.acc { background: var(--accent-soft); color: var(--accent); }
  .pos { color: var(--win); } .neg { color: var(--loss); }
  .matchups { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 10px; }
  .mu { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; display: grid; grid-template-columns: 1fr auto; row-gap: 4px; align-items: center; }
  .mu .team { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mu .team .tn { color: var(--muted); font-size: 0.8rem; display: block; overflow: hidden; text-overflow: ellipsis; }
  .mu .pts { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
  .mu .winner { font-weight: 700; }
  .mu .loser, .mu .loser .tn { color: var(--muted); }
  .mu .foot { grid-column: 1 / -1; border: 0; padding: 4px 0 0; font-size: 0.78rem; color: var(--muted); }
  details { border: 1px solid var(--line); border-radius: 10px; padding: 8px 14px; margin: 10px 0; }
  details summary { cursor: pointer; font-weight: 600; }
  details[open] summary { margin-bottom: 8px; }
  .tc { display: inline-flex; flex-direction: column; line-height: 1.25; }
  .tc-sub { color: var(--muted); font-size: 0.78rem; }
  .tbl td:has(.tc) { white-space: normal; min-width: 180px; }
  .badges { display: inline-flex; align-items: center; gap: 4px; vertical-align: middle; margin-left: 4px; }
  .badges img { width: 18px; height: 18px; object-fit: contain; vertical-align: middle; display: block; }
  .badges .emoji { font-size: 15px; line-height: 18px; display: block; }
  .badges.lg { gap: 12px; margin: 6px 0 10px; }
  .badges.lg img { width: 44px; height: 44px; }
  .badges.lg .emoji { font-size: 34px; line-height: 44px; }
  .tip { position: relative; display: inline-block; cursor: default; outline: none; }
  .tip::after { content: attr(data-tip); position: absolute; left: 50%; bottom: calc(100% + 6px); transform: translateX(-50%);
    background: #1a1d21; color: #fff; font-size: 0.75rem; line-height: 1.3; padding: 5px 9px; border-radius: 6px;
    white-space: nowrap; display: none; pointer-events: none; z-index: 20; }
  .tip:hover::after, .tip:focus::after, .tip:focus-visible::after { display: block; }
  .tbl-wrap { overflow-y: visible; }
  .tbl tr.bye-line td { border-bottom: 2px dotted var(--gold); }
  .tbl tr.playoff-line td { border-bottom: 2px dotted var(--accent); }
  .cell-row { display: inline-flex; align-items: flex-start; gap: 6px; }
  .mark { font-weight: 800; font-size: 0.85rem; line-height: 1.3; }
  .mark.x { color: var(--win); } .mark.e { color: var(--loss); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 6px; }
  .line-key { display: inline-block; width: 26px; border-top: 2px dotted; vertical-align: middle; margin-right: 6px; }
  .line-key.bye { border-color: var(--gold); } .line-key.po { border-color: var(--accent); }
  .profile dd img { width: 22px; height: 22px; object-fit: contain; vertical-align: middle; margin-right: 6px; }
  .profile dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 0; }
  .profile dt { color: var(--muted); font-size: 0.85rem; }
  .profile dd { margin: 0; }
  .hide-sm { }
  @media (max-width: 640px) {
    .hide-sm { display: none; }
    h1 { font-size: 1.35rem; }
    .stat .val { font-size: 1.1rem; }
  }
</style>
